# Native development only: supply the URL-encoded development role password.
# Never use a production/Neon URL for local migration work. See DEVELOPMENT.md.
DATABASE_URL=postgresql+psycopg://sandcastle_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/sandcastle_dev

# The underlying IG authentication base URL. DEPRECATED - made obsolete by IS framework.
IG_AUTH_BASE_URL=

# IS authentication framework integration. Should be something like https://sandcastle-auth.vercel.app/api/auth . Change if you deployed a custom IS.
IS_ISSUER=https://sandcastle-auth.vercel.app/api/auth

# IS client ID - provided by IS application after you add Sandcastle into the list of approved applications.
IS_CLIENT_ID=

# IS client secret - provided by IS application after you add Sandcastle into the list of approved applications. IS does not keep this value.
IS_CLIENT_SECRET=

# A random string used for encrypting and producing hashes within Sandcastle. Create using the following command:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDCASTLE_AUTH_SECRET=

# Secret key used for encrypting the provider secrets. Create using the following command:
# python - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
SANDCASTLE_PROVIDER_SECRET_ENCRYPTION_KEY=

# Callback function for Sandcastle. Should be something like https://sandcastle-api.vercel.app/api/auth/callback. Change if you deployed a custom Sandcastle.
SANDCASTLE_AUTH_CALLBACK_URL=https://sandcastle-gui.vercel.app/api/auth/callback

# The frontend for Sandcastle. Should be something like https://sandcastle-web.vercel.app. Change if you deployed a custom Sandcastle.
SANDCASTLE_WEB_URL=https://sandcastle-web.vercel.app

# Requires HTTPS for session cookies; cookies are signed, not encrypted.
SANDCASTLE_COOKIE_SECURE=false
